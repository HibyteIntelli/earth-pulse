{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm install)",
      "Bash(npm install:*)",
      "Bash(npm ci)",
      "Bash(npm run build)",
      "Bash(npm run build:*)",
      "Bash(npm run test)",
      "Bash(npm run test:*)",
      "Bash(npm run start)",
      "Bash(npm run watch)",
      "Bash(npm run lint)",
      "Bash(npm run lint:*)",
      "Bash(npx ng:*)",
      "Bash(npx prettier:*)",
      "Bash(npx vitest:*)",
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git diff:*)",
      "Bash(git log)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch)",
      "Bash(git branch:*)"
    ]
  }
}