# Copy this file to .env and fill in the values
# .env is gitignored, never commit it

POSTGRES_USER=...
POSTGRES_PASSWORD=...
POSTGRES_DB=...

# Leave blank on first run, copy from generated-jwk.json.
APP_JWT_PRIVATE_KEY=

# Shared secret for internal endpoints (X-Internal-Secret header) — min 32 random chars
APP_INTERNAL_SECRET=

# SMTP — leave defaults to use local Mailpit (docker compose up -d mailpit)
# For prod replace with real SMTP relay credentials
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
