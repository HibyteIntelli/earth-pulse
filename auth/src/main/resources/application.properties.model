spring.application.name=auth
server.port=8083

# Database
spring.datasource.url=jdbc:postgresql://localhost:5432/<POSTGRES_DB>
spring.datasource.username=<POSTGRES_USER>
spring.datasource.password=<POSTGRES_PASSWORD>
spring.datasource.driver-class-name=org.postgresql.Driver

spring.jpa.hibernate.ddl-auto=validate

# Flyway — manages schema migrations
spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration
spring.flyway.baseline-on-migrate=true
spring.flyway.baseline-version=3

# Service identity — used as the JWT issuer claim (iss)
app.base-url=http://localhost:8083

# Frontend SPA origin — used to build user-facing links (e.g. password reset emails)
app.frontend-url=http://localhost:4200

# Shared secret for internal endpoints called by the Notifier Service (X-Internal-Secret header)
app.internal-secret=<RANDOM_SECRET_MIN_32_CHARS>

# Rate limiting — max requests per IP per minute for auth endpoints
app.rate-limit.login=10
app.rate-limit.signup=5
app.rate-limit.refill-duration=PT1M

# Watches — max watches a single user can create
app.watch.max-per-user=200

# Banned passwords — absolute paths to the rockyou.txt wordlist and the serialized bloom filter cache
# On first startup the bloom filter is built from rockyou.txt and written to bloom-path (~15s).
# Subsequent startups load the pre-built filter (~0.5s). See README for setup instructions.
app.banned-passwords.txt-path=<ABSOLUTE_PATH_TO_ROCKYOU_TXT>
app.banned-passwords.bloom-path=<ABSOLUTE_PATH_TO_BANNED_PASSWORDS_BLOOM>

# Generated JWK path (written only when APP_JWT_PRIVATE_KEY is not set)
app.generated-key-path=${user.dir}/generated-jwk.json

# Avatar storage — local filesystem
app.avatar.storage-dir=${user.dir}/src/main/resources/avatar-store
app.avatar.public-base-url=http://localhost:8083/avatars

# Multipart upload limits — keep max-file-size in sync with app.avatar.max-file-size-bytes
spring.servlet.multipart.max-file-size=1MB
spring.servlet.multipart.max-request-size=2MB
app.avatar.max-file-size-bytes=1048576

# Mail — Mailpit for local dev (SMTP on 1025, web UI on http://localhost:8025)
spring.mail.host=${SMTP_HOST:localhost}
spring.mail.port=${SMTP_PORT:1025}
spring.mail.username=${SMTP_USER:}
spring.mail.password=${SMTP_PASSWORD:}
spring.mail.properties.mail.smtp.auth=false
spring.mail.properties.mail.smtp.starttls.enable=false
app.mail.from=noreply@earthpulse.local

# Password reset — token expiry in minutes
app.password-reset.token-expiry-minutes=60

# Rate limiting — forgot-password and reset-password endpoints
app.rate-limit.forgot-password=5
