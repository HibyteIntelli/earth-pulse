spring.application.name=ingestion
server.port=8081

# Database
spring.datasource.url=jdbc:postgresql://localhost:5433/<POSTGRES_DB>
spring.datasource.username=<POSTGRES_USER>
spring.datasource.password=<POSTGRES_PASSWORD>
spring.datasource.driver-class-name=org.postgresql.Driver

spring.jpa.hibernate.ddl-auto=update

# EONET integration
eonet.base-url=https://eonet.gsfc.nasa.gov

# Poll interval
eonet.poll-interval-ms=3600000

# RestClient timeouts
eonet.connect-timeout=5s
eonet.read-timeout=10s

# Backfill window (first boot) + poll window
eonet.backfill-days=30
eonet.poll-days=30

# Initial delay before the first scheduled poll (backfill itself has no delay)
eonet.poll-initial-delay-ms=60000

# Security — validate JWTs issued by the Auth Service (resource server)
spring.security.oauth2.resourceserver.jwt.jwk-set-uri=http://localhost:8083/.well-known/jwks.json

# Shared secret for internal endpoints called by the Notifier Service (X-Internal-Secret header)
ingestion.internal-secret=${INGESTION_INTERNAL_SECRET}
