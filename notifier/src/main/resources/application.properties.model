spring.application.name=notifier

server.port=8084

spring.datasource.url=jdbc:postgresql://localhost:5435/notifier_db
spring.datasource.username=<POSTGRES_USER>
spring.datasource.password=<POSTGRES_PASSWORD>
# First run only: set to "create" to let Hibernate build the schema from scratch, then switch back to "update"
spring.jpa.hibernate.ddl-auto=update

spring.mail.host=localhost
spring.mail.port=1025
spring.mail.from=noreply@earth-pulse.local
spring.mail.properties.mail.smtp.auth=false
spring.mail.properties.mail.smtp.starttls.enable=false

spring.security.oauth2.resourceserver.jwt.jwk-set-uri=http://localhost:8083/.well-known/jwks.json

spring.mvc.problemdetails.enabled=true

# Secret this service checks on incoming /internal/** calls (from Ingestion)
notifier.internal-secret=<INTERNAL_SECRET>

# Daily digest job schedule (cron) — default: 08:00 server time.
# Try "0 * * * * *" (every minute) locally if you want to watch it fire without waiting a day.
notifier.digest.cron=0 0 8 * * *

# Auth Service — watch matching (auth's own server.port is 8083, per auth/README.md)
app.auth-service.url=http://localhost:8083
app.auth-service.internal-secret=<INTERNAL_SECRET>

# LLM Service — briefing generation (llm's own server.port is 8080, per llm/README.md)
app.llm-service.url=http://localhost:8080
app.llm-service.internal-secret=<INTERNAL_SECRET>

# Frontend — used to build event links in notification emails
app.frontend.base-url=http://localhost:4200
